<script>
  // Open "How we calculated this" when a footnote link is used.
  (function () {
    var d = document.getElementById("math");
    function openFor(hash) {
      if (d && hash && /^#m-[a-z]+$/.test(hash)) { d.open = true; var t = document.querySelector(hash); if (t) t.scrollIntoView({ block: "center" }); }
    }
    document.querySelectorAll('.facts-page sup a').forEach(function (a) {
      a.addEventListener("click", function (e) { e.preventDefault(); history.replaceState(null, "", a.getAttribute("href")); openFor(a.getAttribute("href")); });
    });
    openFor(location.hash);
  })();
</script>
