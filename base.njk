<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/">Stop <span>NJ</span> Data Centers</a>
      <nav aria-label="Main">
        <a href="/act/" {% if page.url == "/act/" %}aria-current="page"{% endif %}>Take Action</a>
        <a href="/south-brunswick/" {% if page.url == "/south-brunswick/" %}aria-current="page"{% endif %}>The Facts</a>
        <a href="/documents/" {% if page.url == "/documents/" %}aria-current="page"{% endif %}>Records</a>
        <a href="/about/" {% if page.url == "/about/" %}aria-current="page"{% endif %}>About</a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div>
        <strong>{{ site.name }}</strong>
        <p>Contact: <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        <p class="footer-links"><a href="/act/">Take Action</a> · <a href="/comment/">Comment to NJDEP</a> · <a href="/write/">Write your legislators</a> · <a href="/south-brunswick/">The Facts</a> · <a href="/officials/">Officials</a> · <a href="/documents/">Records</a> · <a href="/about/">About</a></p>
        <p><a href="mailto:{{ site.email }}?subject={{ ('Correction: ' + site.url + page.url) | urlencode }}&amp;body={{ 'What is wrong, and what is the correct information? A link to a source helps.' | urlencode }}">Report an error or inaccuracy</a></p>
        <p class="footer-note">This site was built with the help of AI tools.</p>
      </div>
      <ul class="social" aria-label="Social media">
        {% for s in site.social %}
        <li><a href="{{ s.url }}" rel="noopener">{{ s.name }}: {{ s.label }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </footer>
  <script>
    // Hide time-limited cards (e.g. comment deadlines) after their last day.
    (function () {
      var d = new Date(), today = d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
      document.querySelectorAll("[data-until]").forEach(function (el) {
        if (today > el.getAttribute("data-until")) el.remove();
      });
    })();
  </script>
</body>
</html>
