---
layout: base.njk
permalink: /documents/
title: Records
description: Public records on the data center at 4405 US Route 1 in South Brunswick, NJ, what they show, and the records we're still seeking.
---
{% set c = campaigns["south-brunswick"] %}
{% set postedGroups = [
  { id: "njdep",    heading: "NJDEP air permit file" },
  { id: "township", heading: "South Brunswick Planning Board" }
] %}
{% set others = [
  { status: "requested", heading: "Requested", note: "Someone has already filed for these. Please don't duplicate." },
  { status: "received",  heading: "Received",  note: "We have these and are reviewing them before posting." },
  { status: "denied",    heading: "Denied",    note: "Refused requests, with the agency's stated reason." },
  { status: "wanted",    heading: "Wanted",    note: "No one has requested these yet. Pick one and file it." }
] %}
<section class="page-head">
  <div class="wrap">
    <h1>Public records</h1>
    <p class="lede">What the documents show, with links to the exact pages. Everything below comes from public records.</p>
  </div>
</section>

<section class="wrap section" id="findings">
  <h2>What the records show</h2>
  <ul class="findings">
    {% for f in c.findings %}
    <li><strong>{{ f.title }}</strong> {{ f.text | mdInline | safe }}</li>
    {% endfor %}
  </ul>
</section>

<section class="wrap section" id="posted">
  {% set posted = documents | withStatus("posted") %}
  {% for g in postedGroups %}
  <div class="group">
    <h2>{{ g.heading }}</h2>
    {% for r in posted %}{% if r.group == g.id %}
    <article class="rec doc" id="{{ r.title | slugify }}">
      <div class="rec-main">
        <span class="agency">{{ r.agency }}{% if r.date %} · {{ r.date | readableDate }}{% endif %}</span>
        <h3>{% if r.url %}<a href="{{ r.url }}" rel="noopener">{{ r.title }}</a>{% else %}{{ r.title }}{% endif %}</h3>
        {% if r.summary %}<p class="summary">{{ r.summary | mdInline | safe }}</p>{% endif %}
        {% if r.description or r.key_points or r.open_questions %}
        <details class="more-box">
          <summary>Details{% if r.key_points %} · {{ r.key_points.length }} key point{% if r.key_points.length != 1 %}s{% endif %}{% endif %}{% if r.open_questions %} · {{ r.open_questions.length }} open question{% if r.open_questions.length != 1 %}s{% endif %}{% endif %}</summary>
          {% if r.description %}<p class="muted small">{{ r.description | mdInline | safe }}</p>{% endif %}
          {% if r.key_points %}<div class="points"><strong>Key points</strong><ul>{% for k in r.key_points %}<li>{{ k | mdInline | safe }}</li>{% endfor %}</ul></div>{% endif %}
          {% if r.open_questions %}<div class="points questions"><strong>Open questions</strong><ul>{% for k in r.open_questions %}<li>{{ k | mdInline | safe }}</li>{% endfor %}</ul></div>{% endif %}
        </details>
        {% endif %}
        {% if r.index %}
        <details class="more-box">
          <summary>Key emails by date · {{ r.index.length }}</summary>
          <p class="muted small">Each link opens the page in our excerpt, which is stamped with its page number in the full release.</p>
          <div class="tablewrap"><table class="emailindex">
            <thead><tr><th>Date</th><th>Who</th><th>What it says</th><th>Page</th></tr></thead>
            <tbody>
            {% for e in r.index %}
            <tr><td class="nowrap">{{ e.date | shortDate }}</td><td>{{ e.who }}</td><td>{{ e.what }}</td><td class="nowrap"><a href="{{ e.url }}" rel="noopener">p. {{ e.pages }}</a></td></tr>
            {% endfor %}
            </tbody>
          </table></div>
        </details>
        {% endif %}
      </div>
      {% if r.url %}<div class="side">{% if r.excerpt_url %}<a class="btn small" href="{{ r.excerpt_url }}" rel="noopener">{{ r.excerpt_label }}</a>{% endif %}<a class="btn small" href="{{ r.url }}" rel="noopener">{% if r.excerpt_url %}Full release · {% else %}PDF · {% endif %}{{ r.size }}</a></div>{% endif %}
    </article>
    {% endif %}{% endfor %}
  </div>
  {% endfor %}
  <p class="muted small">We remove residents' personal information before posting. Nothing else is changed.</p>
</section>

<section class="wrap section" id="wanted">
  <h2>Records we're still seeking</h2>
  <div class="howto">
    <strong>Help us get them</strong>
    <ol>
      <li>Pick a record marked <span class="pill p-wanted">Wanted</span>.</li>
      <li>File an Open Public Records Act (OPRA) request with the agency listed, using that agency's official request form.</li>
      <li>Email <a href="mailto:{{ site.email }}?subject=OPRA%20request%20filed">{{ site.email }}</a> with the record and the date you filed, and we'll mark it Requested. We never publish who filed.</li>
    </ol>
    <p class="muted small">Agencies must respond within 7 business days under the <a href="{{ site.laws.opra.url }}" rel="noopener">Open Public Records Act ({{ site.laws.opra.cite }})</a>. <a href="{{ site.laws.opra_guide.url }}" rel="noopener">Plain-English guide</a>. Already have records, photos, or video? Email them to us.</p>
  </div>
  {% for g in others %}
  {% set recs = documents | withStatus(g.status) %}
  {% if recs.length %}
  <div class="group" id="{{ g.status }}">
    <h3 class="group-h">{{ g.heading }} <span class="count">{{ recs.length }}</span></h3>
    <p class="muted small">{{ g.note }}</p>
    <ul class="reclist">
      {% for r in recs %}
      {% set due = r | responseDue %}
      <li{% if r.status == "requested" and due %} data-due="{{ due }}"{% endif %}>
        <div><strong>{{ r.title }}</strong> <span class="agency">{{ r.agency }}</span>
          {% if r.description %}<br><span class="small">{{ r.description | mdInline | safe }}</span>{% endif %}
          {% if r.key_question %}<br><span class="small"><em>Key question:</em> {{ r.key_question | mdInline | safe }}</span>{% endif %}
          {% if r.status == "denied" and r.denial_reason %}<br><span class="small"><em>Reason given:</em> {{ r.denial_reason }}</span>{% endif %}
        </div>
        {% if r.status == "requested" %}<span class="pill p-requested js-status">Requested{% if r.requested %} {{ r.requested | shortDate }}{% endif %}{% if due %} · due {{ due | shortDate }}{% endif %}</span>{% else %}<span class="pill p-{{ r.status }}">{{ g.heading }}</span>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
  {% endfor %}
</section>

<script>
  // Mark requests as Overdue once their response deadline has passed.
  (function () {
    var today = new Date().toISOString().slice(0, 10);
    document.querySelectorAll("[data-due]").forEach(function (el) {
      if (today > el.getAttribute("data-due")) {
        var p = el.querySelector(".js-status");
        if (p) { p.textContent = "Overdue"; p.className = "pill p-overdue js-status"; }
      }
    });
    // Open a document's details when linked to directly.
    var h = location.hash && document.getElementById(location.hash.slice(1));
    if (h) { var d = h.querySelector("details"); if (d) d.open = true; }
  })();
</script>
